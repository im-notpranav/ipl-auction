# ==============================================================================
# IPL Live Auction Arena - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Database & Persistence
# ------------------------------------------------------------------------------
# SUPABASE_URL: The base URL of your Supabase project (e.g. https://xyzcompany.supabase.co).
# Used for connecting to the PostgreSQL database and real-time events.
SUPABASE_URL=""

# SUPABASE_ANON_KEY: Publishable client-side anonymous key.
# Safe to expose in the browser client for read-only / public client subscriptions.
SUPABASE_ANON_KEY=""

# SUPABASE_SERVICE_ROLE_KEY: Highly privileged server-only database key.
# NEVER expose this key to client-side code or browser bundles.
# Used exclusively by the Node/Express backend for atomic transactions, row locks,
# and server-authoritative auction mutations.
SUPABASE_SERVICE_ROLE_KEY=""

# ------------------------------------------------------------------------------
# 2. Cricket Data Integration (External API)
# ------------------------------------------------------------------------------
# CRICKET_API_KEY: External API key for cricket statistics providers (e.g., CricAPI / CricketData / Sportmonks).
# Optional: When omitted, the platform seamlessly runs with zero-latency cached
# verified database of 350+ IPL players.
CRICKET_API_KEY=""

# CRICKET_API_BASE_URL: Base URL endpoint for cricket provider REST endpoints.
CRICKET_API_BASE_URL="https://api.cricapi.com/v1"

# ------------------------------------------------------------------------------
# 3. Player Image Integration (External Image Provider)
# ------------------------------------------------------------------------------
# PLAYER_IMAGE_API_KEY: Dedicated API key for sports photography / player portrait services.
# When omitted, the app uses verified IPL player headshot URLs with high-quality fallback avatars.
PLAYER_IMAGE_API_KEY=""

# PLAYER_IMAGE_BASE_URL: Base URL for requesting player headshots and franchise assets.
PLAYER_IMAGE_BASE_URL="https://api.cricketimages.org/v1"

# ------------------------------------------------------------------------------
# 4. AI Studio / Applet Hosting Environment
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Injected by AI Studio if server-side AI evaluation is enabled.
GEMINI_API_KEY=""

# APP_URL: Current public URL where the auction applet is running.
APP_URL="http://localhost:3000"
